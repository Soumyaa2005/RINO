# Copy to .env and fill in. Never commit .env.

# development | production
APP_ENV=development

# Where the browser reaches Rino (the frontend). Used to build the OAuth callback URL.
APP_BASE_URL=http://localhost:3000

# Long random string used to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Name shown for your organization in Rino.
ORG_NAME=My organization

# GitHub login of the first Admin. The first time this person logs in,
# Rino creates their account as Admin. Everyone else must be invited by an Admin.
BOOTSTRAP_ADMIN_GITHUB_LOGIN=your-github-username

# GitHub App OAuth credentials (GitHub -> Settings -> Developer settings -> GitHub Apps -> your app).
# Callback URL on the app must be: <APP_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local testing only: shows a "dev login" box on the login page so you can sign in
# as an existing user without GitHub. Refused when APP_ENV=production.
DEV_LOGIN_ENABLED=false

# Set by docker-compose; only needed when running the backend outside Docker.
# DATABASE_URL=postgresql+psycopg://rino:rino@localhost:5432/rino
# REDIS_URL=redis://localhost:6379/0
